<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>Tecan.Sila2.Logging</RootNamespace>
        <AssemblyName>Tecan.Sila2.Logging</AssemblyName>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="2.1.1" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Xml" Version="2.1.1" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="2.1.1" />
        <PackageReference Include="Tecan.MAP.Contracts.Services.Logging" Version="2.1.0.14695" />
        <PackageReference Include="Common.Logging" Version="3.4.1" />
        <PackageReference Include="NLog" Version="4.5.11">
            <NoWarn>NU1701</NoWarn>
        </PackageReference>
        <PackageReference Include="Common.Logging.NLog41" Version="3.4.1">
            <NoWarn>NU1701</NoWarn>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Content Include="logging.config" Link="logging.config" CopyToOutputDirectory="Always" />
        <Content Include="nlog.config" Link="nlog.config" CopyToOutputDirectory="Always" />
    </ItemGroup>

    <ItemGroup>
        <None Include="logging.config" Pack="True" PackagePath="lib/netstandard2.0/logging.config" />
        <None Include="nlog.config" Pack="True" PackagePath="lib/netstandard2.0/nlog.config" />
    </ItemGroup>

</Project>
