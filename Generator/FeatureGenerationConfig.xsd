<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://www.sila-standard.org"
           targetNamespace="http://www.sila-standard.org">
    <xs:include schemaLocation="../Framework/Models/Constraints.xsd"/>
    <xs:element name="FeatureGenerationConfig">
        <xs:complexType>
            <xs:sequence>
				<xs:element name="Property" minOccurs="0" maxOccurs="unbounded" type="tns:PropertyMapping" />
                <xs:element name="Constraint" minOccurs="0" maxOccurs="unbounded" type="tns:ConstraintMapping" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="ConstraintMapping">
        <xs:sequence>
            <xs:element name="Constraint" minOccurs="1" maxOccurs="1" type="tns:Constraints" />
        </xs:sequence>
        <xs:attribute name="Element" type="xs:string" use="required" />
    </xs:complexType>
	<xs:complexType name="PropertyMapping">
		<xs:simpleContent>
			<xs:extension base="xs:string">
			    <xs:attribute name="Key" type="xs:string" use="required" />				
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
</xs:schema>
