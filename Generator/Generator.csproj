<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net8.0</TargetFrameworks>
        <RootNamespace>Tecan.Sila2.Generator</RootNamespace>
        <AssemblyName>SilaGen</AssemblyName>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <OutputPath>..\Build\Generator\</OutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <StartupObject />
        <ApplicationIcon />
        <OutputType>Exe</OutputType>
		<RollForward>LatestMajor</RollForward>
    </PropertyGroup>

    <PropertyGroup>
      <DocumentationFile>..\Build\Generator\SilaGen.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
        <PackageReference Include="Microsoft.Build" Version="18.7.1" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Framework" Version="18.7.1" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.7.1" ExcludeAssets="runtime" />
        <PackageReference Include="System.CodeDom" Version="10.0.9" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Annotations\Annotations.csproj" />
        <ProjectReference Include="..\Contracts\Contracts.csproj" />
        <ProjectReference Include="..\DynamicClient\DynamicClient.csproj" />
        <ProjectReference Include="..\Features\Cancellation.Client\Cancellation.Client.csproj" />
        <ProjectReference Include="..\Framework\Framework.csproj" />
    </ItemGroup>
</Project>