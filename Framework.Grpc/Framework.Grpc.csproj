    <AssemblyName>Tecan.Sila2.Grpc</AssemblyName>
    <RootNamespace>Tecan.Sila2.Grpc</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\Build\</OutputPath>
    <DocumentationFile>..\Build\Tecan.Sila2.Grpc.xml</DocumentationFile>
