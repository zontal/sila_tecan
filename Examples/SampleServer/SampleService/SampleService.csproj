<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netcoreapp2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="SampleService.sila.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Condition=" Exists('../../../Server/Server.csproj')" Include="../../../Server/Server.csproj" />
    <PackageReference Condition="!Exists('../../../Server/Server.csproj')" Include="Tecan.Sila2.Server" Version="1.0.35" />

    <ProjectReference Include="../SampleImplementation/SampleImplementation.csproj" />

    <PackageReference Include="Microsoft.Extensions.Configuration" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Xml" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="2.1.1" />

    <PackageReference Include="Common.Logging" Version="3.4.1" />
    <PackageReference Include="NLog" Version="4.5.11">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
    <PackageReference Include="Common.Logging.NLog41" Version="3.4.1">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Logging/logging.config" Link="logging.config" CopyToOutputDirectory="Always" />
    <Content Include="Logging/nlog.config" Link="nlog.config" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
