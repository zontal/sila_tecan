<?xml version="1.0" encoding="utf-8"?>
<Feature xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" SiLA2Version="1.0" FeatureVersion="1.0" Originator="samplecontracts" Category="demo" xmlns="http://www.sila-standard.org">
  <Identifier>SampleService</Identifier>
  <DisplayName>Sample Service</DisplayName>
  <Description>TCI Example SiLA2 Service using the sila_tecan library -- Service to control nothing :)</Description>
  <Command>
    <Identifier>ToUppercase</Identifier>
    <DisplayName>To Uppercase</DisplayName>
    <Description>Converts a string to uppercase</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Input</Identifier>
      <DisplayName>Input</DisplayName>
      <Description>Input string to convert</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Uppercase</Identifier>
      <DisplayName>Uppercase</DisplayName>
      <Description>Input converted to Uppercase</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Response>
  </Command>
  <Command>
    <Identifier>CountTo</Identifier>
    <DisplayName>Count To</DisplayName>
    <Description>Counts up to a given number</Description>
    <Observable>Yes</Observable>
    <Parameter>
      <Identifier>Target</Identifier>
      <DisplayName>Target</DisplayName>
      <Description>Number to count to</Description>
      <DataType>
        <Basic>Integer</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Message</Identifier>
      <DisplayName>Message</DisplayName>
      <Description>User defined message</Description>
      <DataType>
        <Basic>String</Basic>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>CountToResponses</Identifier>
      <DisplayName>Count To Responses</DisplayName>
      <Description>Responses from CountTo command</Description>
      <DataType>
        <DataTypeIdentifier>CountToResponses</DataTypeIdentifier>
      </DataType>
    </Response>
    <IntermediateResponse>
      <Identifier>Intermediate</Identifier>
      <DisplayName>Intermediate</DisplayName>
      <Description />
      <DataType>
        <DataTypeIdentifier>CountToIntermediates</DataTypeIdentifier>
      </DataType>
    </IntermediateResponse>
    <DefinedExecutionErrors>
      <Identifier>InvalidNumber</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Property>
    <Identifier>Version</Identifier>
    <DisplayName>Version</DisplayName>
    <Description>Version string in format major.minor</Description>
    <Observable>No</Observable>
    <DataType>
      <Basic>String</Basic>
    </DataType>
  </Property>
  <Property>
    <Identifier>CurrentTime</Identifier>
    <DisplayName>Current Time</DisplayName>
    <Description>Get the current time</Description>
    <Observable>Yes</Observable>
    <DataType>
      <Basic>String</Basic>
    </DataType>
  </Property>
  <DefinedExecutionError>
    <Identifier>InvalidNumber</Identifier>
    <DisplayName>InvalidNumberException</DisplayName>
    <Description>The specified number was not valid</Description>
  </DefinedExecutionError>
  <DataTypeDefinition>
    <Identifier>CountToResponses</Identifier>
    <DisplayName>Count To Responses</DisplayName>
    <Description>Responses from CountTo command</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>FinalValue</Identifier>
          <DisplayName>Final Value</DisplayName>
          <Description>The Final Value</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>FinalMessage</Identifier>
          <DisplayName>Final Message</DisplayName>
          <Description>Final message from the server</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>
  <DataTypeDefinition>
    <Identifier>CountToIntermediates</Identifier>
    <DisplayName>Count To Intermediate Responses</DisplayName>
    <Description>Intermediate Responses from CountTo command</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>CurrentValue</Identifier>
          <DisplayName>Current Value</DisplayName>
          <Description>The Current Value</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Message</Identifier>
          <DisplayName>Message</DisplayName>
          <Description>Message from the server</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>
</Feature>