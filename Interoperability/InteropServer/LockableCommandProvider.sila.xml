         xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
  <Identifier>LockableCommandProvider</Identifier>
  <DisplayName>Lockable Command Provider</DisplayName>
  <Description>Contains a command that requires locking. The lock is to be obtained through the "Lock Controller" core feature.</Description>
  <Command>
    <Identifier>RequiresLock</Identifier>
    <DisplayName>Requires Lock</DisplayName>
    <Description>Requires a lock identifier in order to be executed</Description>
    <Observable>No</Observable>
  </Command>
