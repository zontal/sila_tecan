<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
  </PropertyGroup>

  <PropertyGroup>
      <TargetFrameworks>netstandard2.0;net10.0;net8.0</TargetFrameworks>
    <RootNamespace>Tecan.Sila2</RootNamespace>
    <AssemblyName>Tecan.Sila2.Auth</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
      <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\..\Build\Features</OutputPath>
    <DocumentationFile>..\..\Build\Features\Tecan.Sila2.Auth.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\..\Build\Features</OutputPath>
    <DocumentationFile>..\..\Build\Features\Tecan.Sila2.Auth.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="AuthenticationService.sila.xml" />
    <None Remove="AuthorizationConfigurationService.sila.xml" />
    <None Remove="AuthorizationService.sila.xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AuthenticationService.sila.xml" />
    <EmbeddedResource Include="AuthorizationConfigurationService.sila.xml" />
    <EmbeddedResource Include="AuthorizationService.sila.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Core" Version="2.46.6" />
    <PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="6.0.8" />
    <PackageReference Include="protobuf-net" Version="3.2.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Annotations\Annotations.csproj" />
    <ProjectReference Include="..\..\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\..\Framework\Framework.csproj" />
  </ItemGroup>
</Project>