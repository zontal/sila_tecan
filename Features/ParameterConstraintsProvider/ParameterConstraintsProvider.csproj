<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <AssemblyName>Tecan.Sila2.ParameterConstraintsProvider</AssemblyName>
        <RootNamespace>Tecan.Sila2.ParameterConstraintsProvider</RootNamespace>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

  <PropertyGroup>
    <OutputPath>..\..\Build\Features\</OutputPath>
    <DocumentationFile>..\..\Build\Features\Tecan.Sila2.ParameterConstraintsProvider.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="ParameterConstraintsProvider.sila.xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ParameterConstraintsProvider.sila.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\..\Framework\Framework.csproj" />
  </ItemGroup>

</Project>
