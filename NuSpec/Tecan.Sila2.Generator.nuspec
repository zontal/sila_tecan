<?xml version="1.0"?>
<package>
    <metadata>
        <id>Tecan.Sila2.Generator</id>
        <description>The code generator of the Tecan SiLA2 SDK for customization purposes</description>
        <version>$version$</version>
        <authors>Tecan Trading AG, Switzerland</authors>
        <owners>Tecan Trading AG, Switzerland</owners>
        <copyright>Copyright 2019 by Tecan Trading AG, Switzerland</copyright>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <license type="expression">BSD-3-Clause</license>
		<icon>images\icon.png</icon>
        <projectUrl>https://gitlab.com/SiLA2/vendors/sila_tecan</projectUrl>
        <repository type="git" url="https://gitlab.com/SiLA2/vendors/sila_tecan.git" commit="$commit_id$" />
        <dependencies>
            <dependency id="Tecan.Sila2" version="[$version$,5.0)" />
            <dependency id="Tecan.Sila2.DynamicClient" version="[$version$,5.0)" />
            <dependency id="CommandLineParser" version="2.9.1" />
            <dependency id="Microsoft.Build" version="18.7.1" />
            <dependency id="Microsoft.Build.Locator" version="1.11.2" />
            <dependency id="Microsoft.Build.Framework" version="18.7.1" />
            <dependency id="Microsoft.Build.Utilities.Core" version="18.7.1" />
            <dependency id="System.CodeDom" version="10.0.9" />
        </dependencies>
		<readme>docs\Tecan.Sila2.Generator.md</readme>
    </metadata>
    <files>
        <file src="..\Build\Generator\net472\SilaGen.exe" target="lib\net472\" />
        <file src="..\Build\Generator\net472\SilaGen.pdb" target="lib\net472\" />
        <file src="..\Build\Generator\SilaGen.xml" target="lib\net472\" />
		
        <file src="..\Build\Generator\net8.0\SilaGen.dll" target="lib\net8.0\" />
        <file src="..\Build\Generator\net8.0\SilaGen.pdb" target="lib\net8.0\" />
        <file src="..\Build\Generator\SilaGen.xml" target="lib\net8.0\" />

		<file src="icon.png" target="images" />
		<file src="Tecan.Sila2.Generator.md" target="docs" />
    </files>
</package>