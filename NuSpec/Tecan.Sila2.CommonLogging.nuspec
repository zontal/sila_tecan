<?xml version="1.0"?>
<package>
    <metadata>
        <id>Tecan.Sila2.CommonLogging</id>
        <description>An adapter to use Common.Logging implementations with the Tecan SiLA2 SDK</description>
        <version>2.0.0-local</version>
        <authors>Tecan Trading AG, Switzerland</authors>
        <owners>Tecan Trading AG, Switzerland</owners>
        <copyright>Copyright 2019 by Tecan Trading AG, Switzerland</copyright>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <license type="expression">BSD-3-Clause</license>
        <projectUrl>https://gitlab.com/SiLA2/vendors/sila_tecan</projectUrl>
        <repository type="git" url="https://gitlab.com/SiLA2/vendors/sila_tecan.git" />
        <dependencies>
            <dependency id="Tecan.Sila2.Server" version="[3.0,4.0)" />
            <dependency id="Common.Logging" version="3.4.1" />
            <dependency id="Microsoft.Extensions.Configuration" version="2.1.1" />
            <dependency id="Microsoft.Extensions.Configuration.Binder" version="2.1.1" />
            <dependency id="Microsoft.Extensions.Configuration.Xml" version="2.1.1" />
            <dependency id="System.ComponentModel.Composition" version="4.6.0" />
            <dependency id="Tecan.MAP.Contracts.Services.Logging" version="[2.1,5.0)" />
        </dependencies>
    </metadata>
    <files>
        <file src="..\Build\netstandard2.0\Tecan.Sila2.Server.dll" target="lib\netstandard2.0\" />
        <file src="..\Build\netstandard2.0\Tecan.Sila2.Server.pdb" target="lib\netstandard2.0\" />
        <file src="..\Build\Tecan.Sila2.Server.xml" target="lib\netstandard2.0\" />
    </files>
</package>