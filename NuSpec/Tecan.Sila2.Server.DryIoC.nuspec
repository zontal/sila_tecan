<?xml version="1.0"?>
<package>
    <metadata>
        <id>Tecan.Sila2.Server.DryIoC</id>
        <description>DryIoC bindings for the server part of the Tecan SiLA2 SDK</description>
        <version>$version$</version>
        <authors>Tecan Trading Ltd., Switzerland</authors>
        <owners>Tecan Trading Ltd., Switzerland</owners>
        <copyright>Copyright 2019 by Tecan Trading Ltd., Switzerland</copyright>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
