        <repository type="git" url="https://gitlab.com/SiLA2/vendors/sila_tecan.git" />
        <dependencies>
            <dependency id="Tecan.Sila2.Contracts" version="[$version$,5.0)" />
            <dependency id="Grpc.Core" version="2.46.6" />
			<dependency id="Makaretu.Dns.Multicast.New" version="0.38.0" />
        </dependencies>
    </metadata>
