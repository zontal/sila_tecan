<?xml version="1.0"?>

<package>
    <metadata>
        <id>Tecan.Sila2.Grpc</id>
        <description>The common gRPC implementation of the Tecan SiLA2 SDK</description>
        <version>$version$</version>
        <authors>Tecan Trading Ltd., Switzerland</authors>
        <owners>Tecan Trading Ltd., Switzerland</owners>
        <copyright>Copyright 2019 by Tecan Trading Ltd., Switzerland</copyright>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <license type="expression">BSD-3-Clause</license>
		<icon>images\icon.png</icon>
        <projectUrl>https://gitlab.com/SiLA2/vendors/sila_tecan</projectUrl>
        <repository type="git" url="https://github.com/zontal/sila_tecan" commit="$commit_id$" />
        <dependencies>
            <dependency id="Tecan.Sila2.Contracts" version="[$version$,5.0)" />
            <dependency id="Grpc.Core" version="2.46.6" />
        </dependencies>
		<readme>docs\Tecan.Sila2.Grpc.md</readme>
    </metadata>
    <files>
        <file src="..\Build\netstandard2.0\Tecan.Sila2.Grpc.dll" target="lib\netstandard2.0\" />
        <file src="..\Build\netstandard2.0\Tecan.Sila2.Grpc.pdb" target="lib\netstandard2.0\" />
        <file src="..\Build\netstandard2.0\Tecan.Sila2.Grpc.xml" target="lib\netstandard2.0\" />

        <file src="..\Build\net10.0\Tecan.Sila2.Grpc.dll" target="lib\net10.0\" />
        <file src="..\Build\net10.0\Tecan.Sila2.Grpc.pdb" target="lib\net10.0\" />
        <file src="..\Build\net10.0\Tecan.Sila2.Grpc.xml" target="lib\net10.0\" />

		<file src="..\Build\net8.0\Tecan.Sila2.Grpc.dll" target="lib\net8.0\" />
		<file src="..\Build\net8.0\Tecan.Sila2.Grpc.pdb" target="lib\net8.0\" />
		<file src="..\Build\net8.0\Tecan.Sila2.Grpc.xml" target="lib\net8.0\" />

		<file src="icon.png" target="images" />
		<file src="Tecan.Sila2.Grpc.md" target="docs" />
    </files>
</package>